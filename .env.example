# ==============================================================================
# EchoSense System Configuration & Environment Variables
# ==============================================================================

# Server & Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=False
BACKEND_SECRET_KEY=echosense-prod-sec-key-replace-with-uuid4

# Device Authentication Keys (Shared Secret between ESP Devices & Backend)
ESP32_API_KEY=esp32_auth_token_9472e0a4f5b18
ESP8266_API_KEY=esp8266_auth_token_38c92a17df40c

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
AUDIO_WINDOW_SECONDS=0.975
AUDIO_STEP_SECONDS=0.5
AUDIO_RMS_THRESHOLD=0.015
AUDIO_SILENCE_SNR_DB=12.0

# YAMNet Classification & Validation Thresholds
YAMNET_CONFIDENCE_LOW=0.45
YAMNET_CONFIDENCE_VALID=0.65
YAMNET_CONFIDENCE_HIGH=0.80
TEMPORAL_VALIDATION_WINDOWS=3
TEMPORAL_REQUIRED_CONFIRMATIONS=2
EVENT_COOLDOWN_SECONDS=25

# WhatsApp Notification Service Configuration
# Supported Providers: "meta" (Cloud API), "twilio", or "mock" (Development/Local)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id

# Twilio Fallback Configuration (if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# Notification Safety Limits
MAX_EMERGENCY_CONTACTS=5
WHATSAPP_RATE_LIMIT_SECONDS=15
NOTIFY_ON_CRITICAL=True
NOTIFY_ON_SOS=True
NOTIFY_ON_WARNING=False

# Heartbeat & Health Monitoring
HEARTBEAT_TIMEOUT_SECONDS=10
